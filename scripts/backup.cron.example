# Backup DB mỗi đêm lúc 2h + trước deploy (systemd timer thay thế cũng được)
0 2 * * * cd /srv/lumina && DATABASE_URL="$DATABASE_URL" BACKUP_ENCRYPTION_KEY="$BACKUP_ENCRYPTION_KEY" BACKUP_HOOK="rclone copyto $FILE remote:lumina-backups/$(basename $FILE)" node scripts/db-backup.mjs --encrypt >> /var/log/lumina-backup.log 2>&1
