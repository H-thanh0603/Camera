// Prisma schema — SQLite cho dev/demo, Postgres cho production.
// Schema chỉ dùng kiểu portable (String/Int/Json/DateTime/Boolean/Float).
// Deploy Postgres: KHÔNG migrate deploy / db push trực tiếp.
// Chạy `node scripts/db-pg-init.mjs --seed` (apply prisma/postgres-baseline.sql
// đã verify + extensions). Mọi đổi schema sau đó phải là migration mới.
// Baseline Postgres: prisma/schema.postgres.prisma + prisma/postgres-baseline.sql
// (drill 2026-09-10, xem docs/backup-drill-log.md; CI khóa drift mỗi push).
// Backup định kỳ: npm run db:backup (pg_dump) — xem docs/runbook.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  // URL cấu hình ở prisma.config.ts (root). Provider đổi sqlite/postgres
  // theo môi trường — xem schema.postgres.prisma cho production.
  provider = "sqlite"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role        String    @default("customer") // customer | admin
  isBanned    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  sessions     Session[]
  orders       Order[]
  reviews      Review[]
  auditLogs    AuditLog[]
  passwordResetTokens PasswordResetToken[]
  savedBattles SavedBattle[]
  totpChallenges TotpChallenge[]
  // 2FA TOTP: secret base32 (chỉ có nghĩa khi totpEnabled), backup codes SHA-256
  totpSecret String?
  totpEnabled Boolean @default(false)
  totpBackupCodes Json @default("[]")
}

model TotpChallenge {  // Thử thách 2FA sau password: 5 phút, dùng 1 lần.
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Product {
  id               String           @id
  sku              String           @unique
  slug             String           @unique
  name             String
  brand            String
  category         String
  subcategory      String
  description      String
  shortDescription String
  price            Int
  compareAtPrice   Int?
  // Ngày kết thúc KM — Offer priceValidUntil chỉ emit khi có giá sale + ngày tương lai
  saleEndsAt       DateTime?
  currency         String           @default("VND")
  stock            Int              @default(0)
  availability     String           @default("in_stock")
  images           Json
  thumbnail        Json
  specifications   Json
  rating           Float            @default(0)
  reviewCount      Int              @default(0)
  // Đánh giá nền từ seed — BẤT BIẾN sau seed, dùng để tính rating chuẩn:
  // rating = (seedTotal + sum(approved)) / (seedCount + count(approved))
  seedCount        Int              @default(0)
  seedTotal        Float            @default(0)
  tags             Json
  // Chuỗi tag phi chuẩn hóa "|flagship|cine|" để filter LIKE portable
  // (SQLite + Postgres) — thay thế cho query JSON array
  tagString        String   @default("|")
  // Văn bản tìm kiếm gộp đã chuẩn hóa không dấu (name/brand/subcategory/sku/tags)
  searchText       String   @default("")
  badges           Json
  monthlyFrom      Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  highlights       Json?
  inTheBox         Json?
  compatibleWith   Json?
  variants         ProductVariant[]

  @@index([category])
  @@index([brand])
  @@index([price])
  @@index([rating])
  @@index([createdAt])
}

model ProductVariant {
  id             String   @id
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String   @unique
  name           String
  price          Int
  compareAtPrice Int?
  stock          Int      @default(0)
  availability   String
  image          Json?
  @@index([productId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Order {
  id         String      @id @default(cuid())
  number     String      @unique
  // null = khách vãng lai (guest checkout)
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  status     String      @default("pending") // pending|paid|processing|shipped|delivered|cancelled|refunded — enum ở APP (FORWARD/CANCELLABLE); SQLite không CHECK được
  // bước timeline hiện tại: order_placed..delivered (xem ORDER_STEP_ORDER)
  currentStep String     @default("confirmed")
  contact    Json
  shipping   Json
  delivery   String
  payment    String
  // snapshot tổng tiền do SERVER tính — client không được tin giá tự tính
  totals     Json
  // Cột vô hướng cho báo cáo (aggregate SUM/GROUP trong DB thay vì reduce JS)
  totalAmount Int @default(0)
  // chống double-submit: client gửi key ngẫu nhiên 1 lần per intent
  idempotencyKey String? @unique
  // Đơn khách vãng lai: chỉ ai giữ raw token (trả 1 lần lúc đặt hàng) mới
  // được xem/hủy/thanh toán. DB chỉ lưu SHA-256 — lộ DB không đủ mạo danh.
  guestTokenHash String? @unique
  // Vận đơn: admin nhập khi bàn giao cho GHN/GHTK (xem docs/shipping-integration.md)
  trackingCode String?
  carrier String?
  lines      OrderLine[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([userId])
  @@index([createdAt])
  @@index([status])
}

model OrderLine {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  variantId  String?
  name       String
  variantName String?
  // giá server đã verify tại thời điểm đặt hàng
  unitPrice  Int
  quantity   Int
  image      String
  sku        String

  @@index([orderId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  // null = guest review
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  author    String
  rating    Int
  title     String
  body      String
  // review phải qua kiểm duyệt trước khi hiển thị công khai
  approved  Boolean  @default(false)
  verified  Boolean  @default(false)
  // ảnh thực tế (tối đa 3 URL) + mã thưởng khi review có ảnh được duyệt
  photos      Json     @default("[]")
  rewardCode  String?
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([approved])
  @@index([productId, approved])
}

model Coupon {
  code        String    @id
  kind        String    // percent | fixed
  value       Int       // percent 1..90 hoặc số tiền VND
  minSubtotal Int       @default(0)
  maxUses     Int?
  usedCount   Int       @default(0)
  active      Boolean   @default(true)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([active])
}

model PaymentEvent {  // Dedupe webhook cổng thanh toán: (provider, eventId) duy nhất.
  // Retry cùng event → phát hiện trùng, không apply 2 lần.
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  orderNumber String
  status      String
  // Meta riêng cổng (vd VNPay: transactionNo/payDate) — refund cần tra cứu
  meta        Json?
  createdAt   DateTime @default(now())

  @@unique([provider, eventId])
  @@index([orderNumber])
}

model SavedBattle {  // Battle user đã lưu: share + xem lại sau.
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String   @default("")
  productIds Json     // string[] (2-4 id)
  createdAt  DateTime @default(now())

  @@index([userId])
}

model EmailOutbox {  // Outbox bền vững: job mail ghi cùng tx nghiệp vụ.
  // Worker + inline best-effort dispatch; fail → backoff, hết lượt → dead.
  // Không cần Redis vẫn không mất mail (Redis chỉ là fast-lane tùy chọn).
  id        String    @id @default(cuid())
  kind      String
  to        String
  subject   String
  html      String
  attempts  Int       @default(0)
  nextRunAt DateTime  @default(now())
  sentAt    DateTime?
  lastError String?
  createdAt DateTime  @default(now())

  @@index([sentAt, nextRunAt])
}

model TradeInLead {  // Lead thu cũ đổi mới: form public, admin gọi lại.
  id           String   @id @default(cuid())
  name         String
  phone        String
  email        String   @default("")
  deviceBrand  String
  deviceModel  String
  condition    String   // like_new | good | fair | broken
  note         String   @default("")
  status       String   @default("new") // new | contacted | quoted | done | dropped
  createdAt    DateTime @default(now())

  @@index([status])
}

model StockMovement {  // Sổ kho: mọi biến động tồn đều ghi dòng (đơn hàng, hủy, nhập tay).
  id           String   @id @default(cuid())
  productId    String
  variantId    String?
  type         String   // in | out | adjust
  quantity     Int      // delta có dấu (+nhập, -xuất)
  balanceAfter Int?     // tồn sau biến động (null khi không đọc lại được)
  reason       String   @default("")
  refOrderId   String?
  createdBy    String?
  createdAt    DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

model SiteSetting {  // Cấu hình site sửa được từ admin (banner, hotline…).
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Article {  // Bài journal — admin CRUD, public chỉ đọc published.
  slug               String   @id
  title              String
  category           String   @default("Camera Guides")
  excerpt            String   @default("")
  author             String   @default("Biên tập Lumina Journal")
  date               DateTime @default(now())
  readingTimeMinutes Int      @default(5)
  heroImage          String   @default("")
  heroAlt            String   @default("")
  body               Json
  relatedSlugs       Json
  published          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([published])
}
