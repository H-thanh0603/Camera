// Prisma schema — SQLite cho dev/demo, Postgres cho production.
// Schema chỉ dùng kiểu portable (String/Int/Json/DateTime/Boolean/Float)
// nên chuyển provider không đổi gì khác.
// Deploy Postgres (Supabase/Neon):
//   1. provider = "sqlite", DATABASE_URL="postgresql://...?sslmode=require"
//   2. npx prisma migrate deploy && npx prisma db seed
//   3. Backup định kỳ: npm run db:backup (pg_dump) — xem docs/runbook.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role        String    @default("customer") // customer | admin
  isBanned    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  sessions     Session[]
  orders       Order[]
  reviews      Review[]
  auditLogs    AuditLog[]
  passwordResetTokens PasswordResetToken[]
}

model Product {
  id               String           @id
  sku              String           @unique
  slug             String           @unique
  name             String
  brand            String
  category         String
  subcategory      String
  description      String
  shortDescription String
  price            Int
  compareAtPrice   Int?
  currency         String           @default("VND")
  stock            Int              @default(0)
  availability     String           @default("in_stock")
  images           Json
  thumbnail        Json
  specifications   Json
  rating           Float            @default(0)
  reviewCount      Int              @default(0)
  // Đánh giá nền từ seed — BẤT BIẾN sau seed, dùng để tính rating chuẩn:
  // rating = (seedTotal + sum(approved)) / (seedCount + count(approved))
  seedCount        Int              @default(0)
  seedTotal        Float            @default(0)
  tags             Json
  badges           Json
  monthlyFrom      Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  highlights       Json?
  inTheBox         Json?
  compatibleWith   Json?
  variants         ProductVariant[]

  @@index([category])
  @@index([brand])
  @@index([price])
  @@index([rating])
  @@index([createdAt])
}

model ProductVariant {
  id             String   @id
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String   @unique
  name           String
  price          Int
  compareAtPrice Int?
  stock          Int      @default(0)
  availability   String
  image          Json?
  @@index([productId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Order {
  id         String      @id @default(cuid())
  number     String      @unique
  // null = khách vãng lai (guest checkout)
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  status     String      @default("pending") // pending|paid|processing|shipped|delivered|cancelled|refunded — enum ở APP (FORWARD/CANCELLABLE); SQLite không CHECK được
  // bước timeline hiện tại: order_placed..delivered (xem ORDER_STEP_ORDER)
  currentStep String     @default("confirmed")
  contact    Json
  shipping   Json
  delivery   String
  payment    String
  // snapshot tổng tiền do SERVER tính — client không được tin giá tự tính
  totals     Json
  // Cột vô hướng cho báo cáo (aggregate SUM/GROUP trong DB thay vì reduce JS)
  totalAmount Int @default(0)
  // chống double-submit: client gửi key ngẫu nhiên 1 lần per intent
  idempotencyKey String? @unique
  lines      OrderLine[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([userId])
  @@index([createdAt])
  @@index([status])
}

model OrderLine {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  variantId  String?
  name       String
  variantName String?
  // giá server đã verify tại thời điểm đặt hàng
  unitPrice  Int
  quantity   Int
  image      String
  sku        String

  @@index([orderId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  // null = guest review
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  author    String
  rating    Int
  title     String
  body      String
  // review phải qua kiểm duyệt trước khi hiển thị công khai
  approved  Boolean  @default(false)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([approved])
  @@index([productId, approved])
}

model Coupon {
  code        String    @id
  kind        String    // percent | fixed
  value       Int       // percent 1..90 hoặc số tiền VND
  minSubtotal Int       @default(0)
  maxUses     Int?
  usedCount   Int       @default(0)
  active      Boolean   @default(true)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([active])
}

model PaymentEvent {
  // Dedupe webhook cổng thanh toán: (provider, eventId) duy nhất.
  // Retry cùng event → phát hiện trùng, không apply 2 lần.
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  orderNumber String
  status      String
  createdAt   DateTime @default(now())

  @@unique([provider, eventId])
  @@index([orderNumber])
}
