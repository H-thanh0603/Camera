// Prisma schema — SQLite cho môi trường dev/demo.
// Deploy production: đổi provider sang "postgresql" + DATABASE_URL (Supabase/Neon),
// schema không đổi gì khác.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role        String    @default("customer") // customer | admin
  createdAt    DateTime  @default(now())
  sessions     Session[]
  orders       Order[]
  reviews      Review[]
  auditLogs    AuditLog[]
}

model Product {
  id               String           @id
  sku              String           @unique
  slug             String           @unique
  name             String
  brand            String
  category         String
  subcategory      String
  description      String
  shortDescription String
  price            Int
  compareAtPrice   Int?
  currency         String           @default("VND")
  stock            Int              @default(0)
  availability     String           @default("in_stock")
  images           Json
  thumbnail        Json
  specifications   Json
  rating           Float            @default(0)
  reviewCount      Int              @default(0)
  tags             Json
  badges           Json
  monthlyFrom      Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  highlights       Json?
  inTheBox         Json?
  compatibleWith   Json?
  variants         ProductVariant[]

  @@index([category])
  @@index([brand])
}

model ProductVariant {
  id             String   @id
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String   @unique
  name           String
  price          Int
  compareAtPrice Int?
  stock          Int      @default(0)
  availability   String
  image          Json?
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Order {
  id         String      @id @default(cuid())
  number     String      @unique
  // null = khách vãng lai (guest checkout)
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  status     String      @default("pending") // pending|paid|processing|shipped|delivered|cancelled|refunded
  // bước timeline hiện tại: order_placed..delivered (xem ORDER_STEP_ORDER)
  currentStep String     @default("confirmed")
  contact    Json
  shipping   Json
  delivery   String
  payment    String
  // snapshot tổng tiền do SERVER tính — client không được tin giá tự tính
  totals     Json
  // chống double-submit: client gửi key ngẫu nhiên 1 lần per intent
  idempotencyKey String? @unique
  lines      OrderLine[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([userId])
  @@index([createdAt])
}

model OrderLine {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  variantId  String?
  name       String
  variantName String?
  // giá server đã verify tại thời điểm đặt hàng
  unitPrice  Int
  quantity   Int
  image      String
  sku        String

  @@index([orderId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  // null = guest review
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  author    String
  rating    Int
  title     String
  body      String
  // review phải qua kiểm duyệt trước khi hiển thị công khai
  approved  Boolean  @default(false)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([approved])
}
